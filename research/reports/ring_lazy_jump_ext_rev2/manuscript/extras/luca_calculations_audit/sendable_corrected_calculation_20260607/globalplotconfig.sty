\pgfplotsset{colormap/viridis}

\pgfplotsset{
  every axis/.append style={
    axis on top = true,
    label style={font=\smaller[0]},
    tick label style={font=\larger[0]},
    legend style={draw=none, font=\tiny,
      fill opacity=0.0,
      text opacity=1,
      % font=\tiny,
      font=\fontsize{4}{5}\selectfont,
    }
  },
  every axis plot/.append style={
    line width = 1pt,
    mark size=1.0pt,
  },
  every tick/.style={black},
}

\pgfplotscreateplotcyclelist{linecolstyles}{
  {plotlinecol0},
  {plotlinecol1, dash pattern = on 3pt off 2pt},
  {plotlinecol2, dash pattern = on 1pt off 2pt},
  {plotlinecol3, dash pattern = on 3pt off 2pt on 1pt off 2pt},
  {plotlinecol4, dash pattern = on 3pt off 2pt on 1pt off 2pt on 1pt off 2pt},
  {plotlinecol5, dash pattern = on 5pt off 2pt on 3pt off 2pt on 1pt off 2pt},
}

\pgfplotscreateplotcyclelist{markcolstyles}{
  {line width=0.5, plotlinecol0, mark=o, only marks},
  {line width=0.5, plotlinecol1, mark=triangle, only marks},
  {line width=0.5, plotlinecol2, mark=square, only marks},
  {line width=0.5, plotlinecol3, mark=square, only marks, mark options={rotate=45, scale=0.75}},
  {line width=0.5, plotlinecol4, mark=triangle, only marks, mark options={rotate=180}},
  {line width=1pt, plotlinecol5, mark=x, only marks, mark options={scale=1.1}},
}

\pgfplotscreateplotcyclelist{markcolstylesfilled}{
