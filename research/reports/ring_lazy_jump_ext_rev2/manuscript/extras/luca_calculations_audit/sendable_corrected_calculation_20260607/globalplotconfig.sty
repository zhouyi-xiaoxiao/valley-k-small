  {line width=0.5, plotlinecol3, mark=square*, only marks, mark options={rotate=45, scale=1}},
  {line width=0.5, plotlinecol4, mark=triangle*, only marks, mark options={rotate=180, scale=1.1}},
  {line width=0.5, plotlinecol5, mark=triangle*, only marks, mark options={scale=1.1}},
}




